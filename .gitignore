# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Environment
.env

# Runtime data (logs, cache, scraped, user CSVs, auth tokens)
# Anchored to repo root so it ignores ONLY the top-level runtime dir, NOT
# source packages like src/rainier/data/ (an unanchored `data/` silently
# excluded src/rainier/data/fear_greed.py from its commit).
/data/

# Trained ML model artifacts
models/

# Charts output
charts/

# Untracked exploratory reports (committed reports follow pf_btest_* convention)
reports/qu100_verification_*
reports/tqqq_*

# Regenerable rendered reports — slim audit R1/R2 (HTML/XLSX are large + reproducible
# from the generating scripts). Source-of-truth docs (e.g. docs/time_series_momentum.pdf,
# pf_btest_*.md) are NOT ignored. Rendered backtest/demo HTML + XLSX are.
docs/*-backtest-*.html
docs/tqqq_*.html
reports/*.html
reports/*.xlsx

# Demo HTML at project root (use reports/ instead)
/index.html

# Design-doc HTML companions are local renders only — the .md is source-of-truth
# and committed; the same-basename .html stays out of git (memory:
# feedback_design_doc_html_companion).
docs/DESIGN-*.html
docs/TASK-PLAN-*.html
docs/TEST-SPEC-*.html
docs/PLAN-*.html
docs/RESEARCH-*.html
docs/SPIKE-*.html
docs/REPORT-*.html

# Champion/challenger model registry + audit corpus are regenerable Parquet
# (feature-store convention, off Neon). The seeded champion.yaml + history/ are
# committed; the registry and corpus caches are not.
config/model/registry.parquet
data/cache/qu100_pattern_audit/

# Coverage
htmlcov/
.coverage
.coverage.*

# pytest
.pytest_cache/

# mypy
.mypy_cache/

# ruff
.ruff_cache/
.gstack/
