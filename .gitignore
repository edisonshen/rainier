# Untracked exploratory reports (committed reports follow pf_btest_* convention)
reports/qu100_verification_*
reports/tqqq_*

# Regenerable rendered reports — slim audit R1/R2 (HTML/XLSX are large + reproducible
# from the generating scripts). Source-of-truth docs (e.g. docs/time_series_momentum.pdf,
# pf_btest_*.md) are NOT ignored. Rendered backtest/demo HTML + XLSX are.
docs/*-backtest-*.html
docs/tqqq_*.html
docs/REPORT-resonance-gate-v1.html
reports/*.html
reports/*.xlsx

# Demo HTML at project root (use reports/ instead)
/index.html

# Design-doc HTML companions are local renders only — the .md is source-of-truth
# and committed; the same-basename .html stays out of git (memory:
# feedback_design_doc_html_companion).
docs/DESIGN-*.html
docs/TASK-PLAN-*.html
docs/TEST-SPEC-*.html
docs/PLAN-*.html
docs/RESEARCH-*.html
docs/SPIKE-*.html

